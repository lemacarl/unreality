# Pinned CI tool versions (ADR 0002). Single source of truth for CI: the
# workflow loads this file into its environment, and
# scripts/ci/check-tool-versions.sh fails if CONTRIBUTING.md ("Tool versions"),
# .swiftlint.yml (swiftlint_version), project.yml (minimumXcodeGenVersion) or
# the installed tools disagree with it.
#
# Format: KEY=value lines only (read by both bash and $GITHUB_ENV).
# To bump a tool: change the version and SHA-256 here (the digest is shown on
# the GitHub release page next to the asset), update the CONTRIBUTING.md
# table and .swiftlint.yml, and check the runner image still ships the Xcode
# version (https://github.com/actions/runner-images).
XCODE_VERSION=26.1.1
SWIFT_VERSION=6.2.1
XCODEGEN_VERSION=2.46.0
XCODEGEN_SHA256=4d9e34b62172d645eed6457cac13fc222569974098ef4ee9c3368bedf0196806
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
